<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataStructuresVisualizer.App">
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>

  <Application.Resources>
    <SolidColorBrush x:Key="AppBackground">#0A1422</SolidColorBrush>
    <SolidColorBrush x:Key="PanelBackground">#122135</SolidColorBrush>
    <SolidColorBrush x:Key="Accent">#2ED7B7</SolidColorBrush>
    <SolidColorBrush x:Key="AccentSoft">#14455A</SolidColorBrush>
    <SolidColorBrush x:Key="Gold">#FFD369</SolidColorBrush>
    <SolidColorBrush x:Key="Muted">#7E90AB</SolidColorBrush>
  </Application.Resources>
</Application>
