<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:DataStructuresVisualizer.Views"
             x:Class="DataStructuresVisualizer.Views.ExamplesView">
  <TabControl Background="Transparent" BorderThickness="0">
    <TabItem Header="Стек: лабиринт DFS">
      <views:MazeView />
    </TabItem>
    <TabItem Header="Очередь: банк / МФЦ">
      <views:QueueView />
    </TabItem>
    <TabItem Header="Дерево: выражение">
      <views:ExpressionTreeView />
    </TabItem>
  </TabControl>
</UserControl>
