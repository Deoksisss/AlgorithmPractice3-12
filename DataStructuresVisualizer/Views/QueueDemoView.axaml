<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataStructuresVisualizer.Views.QueueDemoView">
  <UserControl.Styles>
    <Style Selector="Border.queueCard">
      <Setter Property="Width" Value="92" />
      <Setter Property="Height" Value="54" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Background" Value="#25536F" />
      <Setter Property="BorderBrush" Value="#66C7E8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Transitions">
        <Transitions>
          <DoubleTransition Property="Canvas.Left" Duration="0:0:0.4" />
          <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
          <BrushTransition Property="Background" Duration="0:0:0.2" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.queueCard.headCard">
      <Setter Property="Background" Value="#8A5CF6" />
      <Setter Property="BorderBrush" Value="#D9C7FF" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="Foreground" Value="{StaticResource Accent}" />
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.panelLabel">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="11" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*,250">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="0,0,12,0" Spacing="9">
      <TextBlock Classes="sectionTitle" Text="Раздел 2. Очередь" />
      <TextBlock TextWrapping="Wrap"
                 Foreground="{StaticResource Muted}"
                 Text="Очередь работает по FIFO: Enqueue добавляет в хвост, Dequeue забирает из головы. Обе реализации получают одинаковые операции." />

      <TextBlock Classes="panelLabel" Text="Значение" />
      <TextBox x:Name="QueueValueInput" Text="клиент" />
      <UniformGrid Columns="2" Rows="3">
        <Button Content="Enqueue" Margin="0,0,4,4" Click="Enqueue_Click" />
        <Button Content="Dequeue" Margin="4,0,0,4" Click="Dequeue_Click" />
        <Button Content="Peek" Margin="0,4,4,4" Click="Peek_Click" />
        <Button Content="isEmpty" Margin="4,4,0,4" Click="IsEmpty_Click" />
        <Button Content="Print" Margin="0,4,4,0" Click="Print_Click" />
        <Button Content="Случайные" Margin="4,4,0,0" Click="RandomSequence_Click" />
      </UniformGrid>

      <TextBlock Classes="panelLabel" Text="Набор операций (1,значение 2 3 4 5)" />
      <TextBox x:Name="QueueSequenceInput"
               Height="100"
               AcceptsReturn="True"
               FontFamily="Consolas"
               Text="1,56 1,7 1,cat 3 4 2 5" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Выполнить набор" Click="RunSequence_Click" />
        <Button Content="Стоп" Click="StopSequence_Click" />
      </StackPanel>
      <Button Content="Сбросить очереди" HorizontalAlignment="Stretch" Click="Reset_Click" />
      <Border Background="#15263D" CornerRadius="10" Padding="10">
        <TextBlock x:Name="QueueStatus" TextWrapping="Wrap" Text="Очереди пусты." />
      </Border>
      </StackPanel>
    </ScrollViewer>

    <Grid Grid.Column="1" RowDefinitions="*,*">
      <Border Grid.Row="0" Background="#0C1A2B" CornerRadius="16" Padding="10">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Classes="sectionTitle" Text="Связная очередь" />
          <TextBlock x:Name="LinkedTimeText"
                     Grid.Row="1"
                     Classes="panelLabel"
                     Text="Операция: —" />
          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <Canvas x:Name="LinkedQueueCanvas" Height="96" Width="720" />
          </ScrollViewer>
        </Grid>
      </Border>

      <Border Grid.Row="1" Background="#0C1A2B" CornerRadius="16" Padding="10" Margin="0,10,0,0">
        <Grid RowDefinitions="Auto,Auto,*">
          <TextBlock Classes="sectionTitle" Text="Стандартный Queue&lt;T&gt;" />
          <TextBlock x:Name="StandardTimeText"
                     Grid.Row="1"
                     Classes="panelLabel"
                     Text="Операция: —" />
          <ScrollViewer Grid.Row="2"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled">
            <Canvas x:Name="StandardQueueCanvas" Height="96" Width="720" />
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>

    <StackPanel Grid.Column="2" Margin="12,0,0,0" Spacing="10">
      <Border Background="#15263D" CornerRadius="12" Padding="12">
        <StackPanel Spacing="5">
          <TextBlock Classes="sectionTitle" Text="Состояние" />
          <TextBlock x:Name="QueueCountText" Text="Элементов: 0" />
          <TextBlock x:Name="QueueHeadText" Text="Голова: —" />
        </StackPanel>
      </Border>
      <Border Background="#15263D" CornerRadius="12" Padding="12">
        <StackPanel Spacing="6">
          <TextBlock Classes="sectionTitle" Text="Журнал" />
          <ListBox x:Name="QueueLogList" Height="530" Background="Transparent" />
        </StackPanel>
      </Border>
    </StackPanel>
  </Grid>
</UserControl>
