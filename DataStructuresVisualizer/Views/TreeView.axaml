<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:scene="using:DataStructuresVisualizer.Controls"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DataStructuresVisualizer.Views.ExpressionTreeView">
  <UserControl.Styles>
    <Style Selector="Border.exprNode.current TextBlock">
      <Setter Property="Foreground" Value="#102033" />
    </Style>
    <Style Selector="Border.exprNode">
      <Setter Property="Width" Value="60" />
      <Setter Property="Height" Value="44" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="#284462" />
      <Setter Property="BorderBrush" Value="#537A9D" />
      <Setter Property="Transitions">
        <Transitions>
          <BrushTransition Property="Background" Duration="0:0:0.25" />
          <BrushTransition Property="BorderBrush" Duration="0:0:0.25" />
        </Transitions>
      </Setter>
    </Style>
    <Style Selector="Border.exprNode.operator">
      <Setter Property="Background" Value="#6D4AC4" />
      <Setter Property="BorderBrush" Value="#D2B4FF" />
    </Style>
    <Style Selector="Border.current">
      <Setter Property="Background" Value="#FFD369" />
      <Setter Property="BorderBrush" Value="#FFFFFF" />
    </Style>
    <Style Selector="Border.done">
      <Setter Property="Background" Value="#1E8C66" />
      <Setter Property="BorderBrush" Value="#A5F2D3" />
    </Style>
    <Style Selector="Border.exprNode.cached">
      <Setter Property="Background" Value="#2563EB" />
      <Setter Property="BorderBrush" Value="#BFD4FF" />
    </Style>
    <Style Selector="Line.edge">
      <Setter Property="Stroke" Value="#406083" />
      <Setter Property="StrokeThickness" Value="2" />
    </Style>
    <Style Selector="TextBlock.smallLabel">
      <Setter Property="Foreground" Value="{StaticResource Muted}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </UserControl.Styles>

  <Grid ColumnDefinitions="300,*">
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,12,0" Spacing="10">
      <TextBlock Text="Дерево арифметического выражения" TextWrapping="Wrap"
                 Foreground="{StaticResource Accent}"
                 FontSize="14"
                 FontWeight="SemiBold" />
      <TextBlock Classes="smallLabel"
                 TextWrapping="Wrap"
                 Text="Инфикс → постфикс через стек → построение дерева → рекурсивное вычисление." />

      <TextBlock Text="Выражение" Classes="smallLabel" />
      <TextBox x:Name="ExpressionInput"
               AcceptsReturn="False"
               FontFamily="Consolas,DejaVu Sans Mono"
               Text="(2 + 3) * (5 - 1)" />

      <WrapPanel>
        <Button x:Name="RandomExpressionButton"
                Content="Случайное выражение"
                Click="RandomExpression_Click" />
        <Button x:Name="BuildTreeButton"
                Content="Построить дерево"
                Click="BuildTree_Click" />
      </WrapPanel>
      <WrapPanel>
        <Button x:Name="StartTreeButton"
                Content="Запустить вычисление"
                Click="StartTree_Click" />
        <Button x:Name="StopTreeButton"
                Content="Стоп"
                Click="StopTree_Click" />
        <Button x:Name="ResetTreeButton"
                Content="Сброс"
                Click="ResetTree_Click" />
      </WrapPanel>

      <TextBlock Classes="smallLabel" Text="Постфиксная запись" />
      <Border Background="#15263D" CornerRadius="10" Padding="10">
        <TextBlock x:Name="PostfixText"
                   TextWrapping="Wrap"
                   Text="—" />
      </Border>

      <TextBlock Classes="smallLabel" Text="Результат" />
      <Border Background="#15263D" CornerRadius="10" Padding="10">
        <TextBlock x:Name="ResultText"
                   Text="—"
                   FontSize="24"
                   FontWeight="SemiBold" />
      </Border>

      <TextBlock Classes="smallLabel" Text="LRU-хеш-кэш" />
      <Border Background="#15263D" CornerRadius="10" Padding="10">
        <TextBlock x:Name="LruCacheText"
                   TextWrapping="Wrap"
                   Text="LRU: 0/96 · попаданий 0 · промахов 0 · вытеснений 0" />
      </Border>

      <TextBlock Classes="smallLabel" Text="MRU ↓ недавно использованные · LRU внизу" TextWrapping="Wrap" />
      <ListBox x:Name="CacheEntries" MaxHeight="180" FontSize="11" />
      <Border Background="#15263D" CornerRadius="10" Padding="10">
        <TextBlock x:Name="TreeStatus"
                   TextWrapping="Wrap"
                   Text="Введите выражение или сгенерируйте случайное." />
      </Border>
    </StackPanel></ScrollViewer>

    <Border Grid.Column="1" Background="#0C1A2B" CornerRadius="16" Padding="10">
      <scene:SceneViewport><scene:SceneViewport.Scene>
        <Canvas x:Name="TreeCanvas" Width="450" Height="400" />
      </scene:SceneViewport.Scene></scene:SceneViewport>
    </Border>
  </Grid>
</UserControl>
