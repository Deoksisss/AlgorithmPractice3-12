<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StackQueueLab</RootNamespace>
    <AssemblyName>StackQueueLab</AssemblyName>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <None Update="StackInput\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="QueueInput\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="PostfixInput\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="InfixInput\**\*.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
